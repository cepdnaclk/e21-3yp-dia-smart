[Unit]
Description=Dia-Smart AI Clinical Summary Microservice (FastAPI)
Documentation=https://github.com/cepdnaclk/e21-3yp-dia-smart
After=network.target
Wants=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/diasmart-ai
EnvironmentFile=/etc/diasmart/ai-service.env

# FastAPI is bound strictly to loopback (127.0.0.1:8000)
# Port 8000 is never exposed to public ingress
ExecStart=/opt/diasmart-ai/.venv/bin/python -m uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --timeout-keep-alive 65

Restart=on-failure
RestartSec=5s

# Standard Linux process limits & isolation
LimitNOFILE=65536
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
