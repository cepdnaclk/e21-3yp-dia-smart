# Dia-Smart AI Service Environment Configuration Template

AI_SERVICE_NAME=Dia-Smart AI Service
AI_SERVICE_VERSION=0.1.0
AI_ENVIRONMENT=development

# Target AI Provider. Only 'mock' is supported in Part 2.
AI_PROVIDER=mock

# Internal Bearer Token authentication. Ensure this value is at least 32 characters in production.
AI_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-development-token-of-at-least-32-chars

# Safety limits for inputs
AI_MAX_DATE_RANGE_DAYS=31
AI_MAX_CONTEXT_RECORDS=500
AI_MAX_SELECTED_EVENTS=100
AI_MAX_ALERTS=100
AI_MAX_TEXT_LENGTH=1000

# Logging
AI_LOG_LEVEL=INFO
